# Copy these settings into the root private .env only when selecting browser.
# Keep the actual WireGuard private key in a regular 0600 file, never this value.
GLUETUN_WIREGUARD_KEY_FILE=./local/wireguard-private-key
# Use the IPv4 /32 Address from the same Mullvad-generated WireGuard config.
WIREGUARD_ADDRESSES=
GLUETUN_SERVER_COUNTRIES=
WEBTOP_USER=user
WEBTOP_PASSWORD=
# Existing root PUID/PGID and ./webtop/config identity must be preserved.
