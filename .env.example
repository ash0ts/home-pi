# Documentation only: ./setup.sh configure --project-name NAME generates secrets.
# For migration use the installed com.docker.compose.project label, not a new name.
COMPOSE_PROJECT_NAME=home-pi
TZ=America/New_York
PUID=1000
PGID=1000
PIHOLE_PASSWORD=
PIHOLE_HOSTNAME=pi-hole
PIHOLE_DOMAIN=home.arpa
PIHOLE_DNS=1.1.1.1;1.0.0.1
# Persistent Tailscale state reconnects without retaining an enrollment key.
TS_AUTHKEY=
SPEEDTEST_APP_KEY=
SPEEDTEST_APP_URL=http://localhost:8765
NETDATA_HOSTNAME=pi-netdata
WEBTOP_USER=user
WEBTOP_PASSWORD=

# Set true only after reviewing existing pihole/etc-dnsmasq.d files.
PIHOLE_CUSTOM_DNSMASQ=false
# Explicit harmless DNS probe target and a controlled blocked fixture, set privately.
DNS_PROBE_SERVER=
DNS_PROBE_NAME=example.com
DNS_BLOCK_TEST_NAME=
DNS_BLOCK_TEST_ADDRESS=0.0.0.0

# Backends default to loopback. A specific private LAN IP additionally needs ACK_LAN_ADMIN=yes.
ADMIN_BIND_IP=127.0.0.1
ACK_LAN_ADMIN=no
# Actual enrolled node name, e.g. pi.example-tailnet.ts.net; never a LAN alias.
TAILNET_HOSTNAME=
